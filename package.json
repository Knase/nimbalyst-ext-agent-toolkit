{
  "name": "nimbalyst-agent-toolkit",
  "version": "0.1.0",
  "description": "Agent Toolkit: favorite agent commands, launcher and Actions sync for Nimbalyst",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "vite build && node scripts/validate.mjs",
